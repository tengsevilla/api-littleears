# api-littleears/.env — copy to .env for local dev and fill in. Never commit .env.
# Production values live in Railway service variables (no .env file on Railway); this file is a key list only.

# --- Server ---
PORT=
NODE_ENV=
CORS_ORIGIN=
# Frontend origin for invite links; optional in development (defaults to http://localhost:3000), required in production
APP_URL=

# --- Database ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth (>= 32 chars each) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Admin account seed (required only by the seed script) ---
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Lyrics + safety (openai | mock) ---
LYRICS_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Music + name preview TTS (elevenlabs | mock) ---
MUSIC_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_TTS_VOICE_ID=

# --- Cover images (gemini | mock) ---
IMAGE_PROVIDER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# --- Storage (private bucket; S3_ENDPOINT only for R2) ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Invite emails (resend | mock) ---
# EMAIL_PROVIDER defaults to resend when RESEND_API_KEY is set, else mock; production requires resend + key.
# EMAIL_FROM defaults to "LittleEars <onboarding@resend.dev>" (Resend's test sender: delivers only to the
# Resend account owner's address). Real invites need a sender on a domain verified in Resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# --- Worker ---
WORKER_POLL_MS=
WORKER_MAX_ATTEMPTS=
