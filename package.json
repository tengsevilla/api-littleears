{
  "name": "api-littleears",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "db:seed:prod": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "db:verify-skip-locked": "tsx --env-file=.env src/scripts/verifySkipLocked.ts",
    "audio:measure": "tsx src/scripts/measureLoudness.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@google/genai": "^2.32.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "openai": "^7.45.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
